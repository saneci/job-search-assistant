# Ключ AITUNNEL: https://aitunnel.ru/panel/keys
AITUNNEL_API_KEY=sk-aitunnel-xxx

# Реквизиты SMTP для писем на email: отчёт и уведомления о капче.
# Нужны только если в config.yaml стоит notifications.email.enabled: true.
# Gmail: SMTP_PASSWORD — пароль приложения (аккаунт Google → Безопасность → Пароли приложений),
# а не пароль аккаунта. SMTP_USERNAME по умолчанию совпадает с notifications.email.sender.
SMTP_USERNAME=
SMTP_PASSWORD=
