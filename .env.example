# Ключ AITUNNEL: https://aitunnel.ru/panel/keys
AITUNNEL_API_KEY=sk-aitunnel-xxx

# Реквизиты SMTP для отправки отчёта на email.
# Нужны только если в config.yaml стоит notifications.email.enabled: true.
# SMTP_USERNAME по умолчанию совпадает с notifications.email.sender.
SMTP_USERNAME=
SMTP_PASSWORD=
